# Copy to .env (next to this file). Settings sent from the Copilot UI take precedence over these.

# --- Chat LLM (any OpenAI-compatible endpoint: OpenAI, OpenRouter, LMStudio, Ollama, ...) ---
# CC_OPENAI_BASE_URL=https://api.openai.com/v1
# CC_OPENAI_API_KEY=sk-...
# Model used when the UI does not select one
# CC_DEFAULT_MODEL=gpt-4.1-mini

# --- Workflow agents (rewrite / debug). Unset = reuse the chat settings above ---
# WORKFLOW_LLM_BASE_URL=
# WORKFLOW_LLM_API_KEY=
# WORKFLOW_LLM_MODEL=

# --- Optional MCP servers (SSE). None are used unless configured ---
# A self-hosted Copilot-compatible server providing recall_workflow / gen_workflow
# COPILOT_REMOTE_MCP_URL=https://your-server/mcp-server/mcp
# A web search MCP server
# COPILOT_SEARCH_MCP_URL=
# COPILOT_SEARCH_MCP_API_KEY=
# COPILOT_MCP_CONNECT_TIMEOUT=15
# DISABLE_WORKFLOW_GEN=false

# --- Diagnostics ---
# COPILOT_LOG_LEVEL=INFO
# Uploads openai-agents run traces (prompts, workflows) to OpenAI. Off by default.
# COPILOT_ENABLE_TRACING=false
